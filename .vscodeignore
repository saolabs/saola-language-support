# Chỉ đóng gói thứ extension CẦN lúc chạy:
#   dist/extension.js (main), syntaxes/, snippets/, language-configurations/,
#   images/icon.png, README, LICENSE.
# Trước khi có file này, vsix nuốt cả src/ lẫn out/ (out/ là output của `tsc`,
# không ai load — `main` trỏ dist/ do esbuild bundle).

# Nguồn + output trung gian
src/**
out/**
**/*.ts
**/*.map
tsconfig.json
.eslintrc*
.prettierrc*

# Tài liệu/ví dụ nội bộ — không cần cho người dùng cài extension
docs/**
examples/**
one-icon-theme/**

# Bản đóng gói cũ (vsce vốn đã bỏ qua, ghi rõ cho chắc)
*.vsix
update_extension.sh
create_icon.py
test_viewpath.js
test_format.js
test_*.js
get-started.sh
COMPLETION_REPORT.txt

# PNG 2048px được xuất từ images/logo.svg — giữ trong repo cho thiết kế,
# không đóng gói: Marketplace dùng images/icon.png (256px).
images/icon-2048-source.png
images/one-icon.png

# Lặt vặt
.git/**
.gitignore
.vscode/**
**/.DS_Store

# tsserver chạy trong extension (setupCheck.ts) cần lib.*.d.ts lúc runtime —
# `typescript` là dependency thật, không bundle; giữ lại lib sau dòng **/*.ts.
!node_modules/typescript/lib/**
