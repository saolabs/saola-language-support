{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SAO Template",
  "scopeName": "text.html.saola",
  "fileTypes": ["sao"],
  "foldingStartMarker": "(@(if|foreach|forelse|for|while|unless|switch|can|cannot|canany|auth|guest|section|component|slot|push|prepend|once|php|isset|env|production|verbatim|error|block|comment)\\b|(\\{|\\()\\s*$)",
  "foldingStopMarker": "(@end(if|foreach|forelse|for|while|unless|switch|can|cannot|canany|auth|guest|section|component|slot|push|prepend|once|php|isset|empty|env|production|verbatim|error|block|comment)|^\\s*(\\}|\\)))",
  "patterns": [
    { "include": "#setup-script" },
    {
      "comment": "Legacy PHP Syntax wrapper - Pass-through mode",
      "begin": "(<)(blade)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "end": "(</)(blade)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        { "include": "#legacy-blade" },
        { "include": "text.html.derivative" }
      ]
    },
    {
      "comment": "Modern Syntax wrappers",
      "begin": "(<)(template|sao:blade)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "end": "(</)(template|sao:blade)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        { "include": "#blade" },
        { "include": "text.html.derivative" }
      ]
    },
    {
      "include": "#blade"
    },
    {
      "include": "text.html.derivative"
    }
  ],
  "repository": {
    "setup-script": {
      "name": "meta.embedded.block.saola.setup",
      "begin": "(<)(script)(?=\\s[^>]*\\bsetup(?:\\s|=|>))([^>]*)(>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        },
        "3": {
          "name": "entity.other.attribute-name.html"
        },
        "4": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "end": "(</)(script)(\\s*>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        },
        "3": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "patterns": [
        {
          "include": "#setup-declaration"
        },
        {
          "include": "source.ts"
        }
      ]
    },
    "setup-declaration": {
      "begin": "(?<![A-Za-z0-9_@])(@(?:vars|props|state|states|let|const|computed|asset|assets|useState|importView))\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "keyword.blade"
        },
        "2": {
          "name": "punctuation.definition.arguments.begin.blade"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.arguments.end.blade"
        }
      },
      "patterns": [
        {
          "include": "#nested-parens"
        },
        {
          "include": "#js-expr"
        }
      ]
    },
    "blade": {
      "patterns": [
        {
          "comment": "Blade comment {{-- --}}",
          "begin": "{{--",
          "beginCaptures": {
            "0": {
              "name": "comment.block.blade punctuation.definition.comment.blade"
            }
          },
          "end": "--}}",
          "endCaptures": {
            "0": {
              "name": "comment.block.blade punctuation.definition.comment.blade"
            }
          },
          "name": "comment.block.blade"
        },
        {
          "comment": "@php ... @endphp block with PHP highlighting",
          "begin": "(?<![A-Za-z0-9_@])(@php)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.blade"
            }
          },
          "end": "(?<![A-Za-z0-9_@])(@endphp)\\b",
          "endCaptures": {
            "1": {
              "name": "keyword.blade"
            }
          },
          "contentName": "meta.embedded.inline.php",
          "name": "meta.embedded.block.php.blade",
          "patterns": [
            {
              "include": "#js-expr"
            }
          ]
        },
        {
          "comment": "@comment ... @endcomment as blade comment",
          "begin": "(?<![A-Za-z0-9_@])(@comment)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.blade"
            }
          },
          "end": "(?<![A-Za-z0-9_@])(@endcomment)\\b",
          "endCaptures": {
            "1": {
              "name": "keyword.blade"
            }
          },
          "name": "comment.block.blade.directive"
        },
        {
          "begin": "(?<!@){{{(?!--)",
          "beginCaptures": {
            "0": {
              "name": "support.function.construct.begin.blade"
            }
          },
          "contentName": "meta.embedded.inline.js",
          "end": "}}}",
          "endCaptures": {
            "0": {
              "name": "support.function.construct.end.blade"
            }
          },
          "name": "meta.function.echo.blade",
          "patterns": [
            {
              "include": "#js-expr"
            }
          ]
        },
        {
          "begin": "(?<!@){!!",
          "beginCaptures": {
            "0": {
              "name": "support.function.construct.begin.blade"
            }
          },
          "contentName": "meta.embedded.inline.js",
          "end": "!!}",
          "endCaptures": {
            "0": {
              "name": "support.function.construct.end.blade"
            }
          },
          "name": "meta.function.echo.blade",
          "patterns": [
            {
              "include": "#js-expr"
            }
          ]
        },
        {
          "begin": "(?<![@{]){{(?![{!-]|--)",
          "beginCaptures": {
            "0": {
              "name": "support.function.construct.begin.blade"
            }
          },
          "contentName": "meta.embedded.inline.js",
          "end": "}}",
          "endCaptures": {
            "0": {
              "name": "support.function.construct.end.blade"
            }
          },
          "name": "meta.function.echo.blade",
          "patterns": [
            {
              "include": "#js-expr"
            }
          ]
        },
        {
          "comment": "Event directive with args - @click(), @click.prevent(), @change(), etc.",
          "begin": "(?<![A-Za-z0-9_@])(@(?:click|input|change|submit|keyup|keydown|keypress|focus|blur|mouseenter|mouseleave|mouseover|mouseout|dblclick|contextmenu|wheel|scroll|resize|load|onClick|onInput|onChange|onSubmit|onKeyup|onKeydown|onFocus|onBlur|onMouseenter|onMouseleave)(?:\\.[a-zA-Z0-9_-]+)*)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.event.blade"
            },
            "2": {
              "name": "punctuation.definition.arguments.begin.blade"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.arguments.end.blade"
            }
          },
          "contentName": "meta.embedded.inline.js",
          "patterns": [
            {
              "include": "#nested-parens"
            },
            {
              "include": "#js-expr"
            }
          ]
        },
        {
          "comment": "Blade/Saola directive with parenthesized arguments (standard, system @key, and custom/unregistered directives)",
          "begin": "(?<![A-Za-z0-9_@])(@[a-zA-Z_][a-zA-Z0-9_-]*(?:\\.[a-zA-Z0-9_-]+)*)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "keyword.blade"
            },
            "2": {
              "name": "punctuation.definition.arguments.begin.blade"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.arguments.end.blade"
            }
          },
          "contentName": "meta.embedded.inline.js",
          "patterns": [
            {
              "include": "#nested-parens"
            },
            {
              "include": "#js-expr"
            }
          ]
        },
        {
          "comment": "All Blade/Saola directives without args (standard, system, @end..., and custom/unregistered directives)",
          "match": "(?<![A-Za-z0-9_@])(@[a-zA-Z_][a-zA-Z0-9_-]*(?:\\.[a-zA-Z0-9_-]+)*)\\b",
          "name": "keyword.blade"
        },
        {
          "comment": "Modern Brace block closing",
          "match": "^\\s*\\}\\s*$",
          "name": "keyword.blade"
        }
      ]
    },
    "js-expr": {
      "patterns": [
        {
          "match": "\\b(as)\\b",
          "name": "keyword.control.as.js"
        },
        {
          "match": "\\b(true|false|null|undefined)\\b",
          "name": "constant.language.js"
        },
        {
          "match": "\\b(if|else|foreach|forelse|for|while|do|switch|case|break|continue|return|function|class|const|let|var|await|async|import|export|default|new|this|typeof|instanceof|void|delete|in|of|yield)\\b",
          "name": "keyword.control.js"
        },
        {
          "match": "(?x)\\b(?!(?:true|false|null|undefined|if|else|foreach|forelse|for|while|do|switch|case|break|continue|return|function|class|const|let|var|await|async|import|export|default|new|this|typeof|instanceof|void|delete|in|of|yield|as)\\b)[a-zA-Z_$][a-zA-Z0-9_$]*\\b(?=\\s*\\()",
          "name": "support.function.js"
        },
        {
          "match": "(?x)\\b(?!(?:true|false|null|undefined|if|else|foreach|forelse|for|while|do|switch|case|break|continue|return|function|class|const|let|var|await|async|import|export|default|new|this|typeof|instanceof|void|delete|in|of|yield|as)\\b)[a-zA-Z_$][a-zA-Z0-9_$]*\\b(?=\\s*:)",
          "name": "variable.other.readwrite.js"
        },
        {
          "match": "\\.\\s*([a-zA-Z_$][a-zA-Z0-9_$]*)",
          "captures": {
            "1": {
              "name": "variable.other.property.js"
            }
          }
        },
        {
          "match": "(?x)\\b(?!(?:true|false|null|undefined|if|else|foreach|forelse|for|while|do|switch|case|break|continue|return|function|class|const|let|var|await|async|import|export|default|new|this|typeof|instanceof|void|delete|in|of|yield|as)\\b)[a-zA-Z_$][a-zA-Z0-9_$]*\\b",
          "name": "variable.other.readwrite.js"
        },
        {
          "match": "[\\[\\]]",
          "name": "punctuation.section.bracket.js"
        },
        {
          "match": "[\\(\\)]",
          "name": "punctuation.section.group.js"
        },
        {
          "match": "[\\{\\}]",
          "name": "punctuation.section.block.js"
        },
        {
          "match": "(===|!==|==|!=|<=|>=|<|>|&&|\\|\\||!|\\+|-|\\*|/|%|\\?|:|\\=|\\+\\=|-\\=|\\*\\=|/\\=|%\\=|=>)",
          "name": "keyword.operator.js"
        },
        {
          "match": "'(?:[^'\\\\]|\\\\.)*'",
          "name": "string.quoted.single.js"
        },
        {
          "match": "\"(?:[^\"\\\\]|\\\\.)*\"",
          "name": "string.quoted.double.js"
        },
        {
          "match": "`(?:[^`\\\\]|\\\\.)*`",
          "name": "string.quoted.template.js"
        },
        {
          "match": "\\b\\d+\\.?\\d*\\b",
          "name": "constant.numeric.js"
        }
      ]
    },
    "nested-parens": {
      "begin": "\\(",
      "beginCaptures": { "0": { "name": "punctuation.section.group.js" } },
      "end": "\\)",
      "endCaptures": { "0": { "name": "punctuation.section.group.js" } },
      "patterns": [
        { "include": "#nested-parens" },
        { "include": "#js-expr" }
      ]
    },
    "php-expr": {
      "patterns": [
        {
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*",
          "name": "variable.other.php"
        },
        {
          "match": "->\\w+",
          "name": "variable.other.property.php"
        },
        {
          "match": "\\[\\w+\\]",
          "name": "punctuation.definition.array.php"
        },
        {
          "match": "'(?:[^'\\\\]|\\\\.)*'",
          "name": "string.quoted.single.php"
        },
        {
          "match": "\"(?:[^\"\\\\]|\\\\.)*\"",
          "name": "string.quoted.double.php"
        },
        {
          "match": "\\b(true|false|null|TRUE|FALSE|NULL)\\b",
          "name": "constant.language.php"
        },
        {
          "match": "\\b\\d+\\.?\\d*\\b",
          "name": "constant.numeric.php"
        },
        {
          "match": "(===|==|!=|!==|<=|>=|<|>|&&|\\|\\||and|or|xor|\\+|-|\\*|/|%|\\?|:|=>)",
          "name": "keyword.operator.php"
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "name": "entity.name.function.php"
        }
      ]
    },
    "legacy-blade": {
      "patterns": [
        {
          "begin": "{{--",
          "beginCaptures": { "0": { "name": "comment.block.blade punctuation.definition.comment.blade" } },
          "end": "--}}",
          "endCaptures": { "0": { "name": "comment.block.blade punctuation.definition.comment.blade" } },
          "name": "comment.block.blade"
        },
        {
          "begin": "(?<![@{]){{(?![{!-]|--)",
          "beginCaptures": { "0": { "name": "support.function.construct.begin.blade" } },
          "contentName": "source.php",
          "end": "}}",
          "endCaptures": { "0": { "name": "support.function.construct.end.blade" } },
          "patterns": [{ "include": "#php-expr" }]
        },
        {
          "comment": "Blade/Saola directive with parenthesized arguments (legacy mode - PHP expressions)",
          "begin": "(?<![A-Za-z0-9_@])(@[a-zA-Z_][a-zA-Z0-9_-]*(?:\\.[a-zA-Z0-9_-]+)*)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "keyword.blade" },
            "2": { "name": "punctuation.definition.arguments.begin.blade" }
          },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.definition.arguments.end.blade" } },
          "contentName": "source.php",
          "patterns": [{ "include": "#php-expr" }]
        },
        {
          "comment": "All Blade/Saola directives without args (legacy mode)",
          "match": "(?<![A-Za-z0-9_@])(@[a-zA-Z_][a-zA-Z0-9_-]*(?:\\.[a-zA-Z0-9_-]+)*)\\b",
          "name": "keyword.blade"
        }
      ]
    }
  }
}
